<idea-plugin url="https://github.com/pkelleter/angular-cli-quick-switch-plugin">
    <id>patrick.kelleter.angular-cli-quick-switch</id>
    <name>Angular CLI QuickSwitch</name>
    <vendor email="patrick.kelleter.1987@gmail.com" url="https://github.com/pkelleter/angular-cli-quick-switch-plugin">Patrick Kelleter</vendor>

    <description><![CDATA[
    Angular CLI QuickSwitch cycles between related component files with one shortcut (default Alt + S). Supported extensions are js, ts, html, php, haml, jade, pug, slim, css, sass, scss, less, and styl.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                instance="patrick.kelleter.angularcliquickswitch.QuickSwitchConfigurable"
                id="patrick.kelleter.angular-cli-quick-switch.settings"
                displayName="Angular CLI QuickSwitch"/>
    </extensions>

    <actions>
        <action id="ngxQuickSwitch.QuickSwitch" class="patrick.kelleter.angularcliquickswitch.QuickSwitchAction" text="QuickSwitch"
                description="Quickly switches between Angular CLI files for one component, e.g. ts, html, css">
            <keyboard-shortcut first-keystroke="alt S" keymap="$default"/>
        </action>
    </actions>
</idea-plugin>
