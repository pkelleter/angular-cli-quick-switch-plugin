<idea-plugin url="https://github.com/pkelleter/angular-cli-quick-switch-plugin">
    <id>@PLUGIN_ID@</id>
    <name>@PLUGIN_NAME@</name>
    <vendor email="patrick.kelleter.1987@gmail.com" url="https://github.com/pkelleter/angular-cli-quick-switch-plugin">Patrick Kelleter</vendor>

    <description><![CDATA[
    @PLUGIN_DESCRIPTION@
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <incompatible-with>@INCOMPATIBLE_PLUGIN_ID@</incompatible-with>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                instance="patrick.kelleter.angularcliquickswitch.QuickSwitchConfigurable"
                id="patrick.kelleter.angular-cli-quick-switch.settings"
                displayName="@PLUGIN_NAME@"/>
    </extensions>

    <actions>
        <action id="ngxQuickSwitch.QuickSwitch" class="patrick.kelleter.angularcliquickswitch.QuickSwitchAction" text="@ACTION_PREFIX@: Cycle files"
                description="@CYCLE_ACTION_DESCRIPTION@">
            <keyboard-shortcut first-keystroke="alt S" keymap="$default"/>
        </action>
        <action id="ngxQuickSwitch.Tests" class="patrick.kelleter.angularcliquickswitch.QuickSwitchTestsAction"
                text="@ACTION_PREFIX@: Tests" description="Switches directly to and between related test files">
            <keyboard-shortcut first-keystroke="alt T" keymap="$default"/>
        </action>
        <action id="ngxQuickSwitch.Controllers" class="patrick.kelleter.angularcliquickswitch.QuickSwitchControllersAction"
                text="@ACTION_PREFIX@: @CONTROLLER_ACTION_NAME@" description="@CONTROLLER_ACTION_DESCRIPTION@">
            <keyboard-shortcut first-keystroke="alt X" keymap="$default"/>
        </action>
        <action id="ngxQuickSwitch.Markup" class="patrick.kelleter.angularcliquickswitch.QuickSwitchMarkupAction"
                text="@ACTION_PREFIX@: Markup" description="Switches directly to and between related markup files">
            <keyboard-shortcut first-keystroke="alt C" keymap="$default"/>
        </action>
        <action id="ngxQuickSwitch.Styles" class="patrick.kelleter.angularcliquickswitch.QuickSwitchStylesAction"
                text="@ACTION_PREFIX@: Styles" description="Switches directly to and between related style files">
            <keyboard-shortcut first-keystroke="alt V" keymap="$default"/>
        </action>
    </actions>
</idea-plugin>
